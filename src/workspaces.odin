package pangolin

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strings"

// A workspace is the tool set-up: the tool groups, with their hotkeys, switches, operations and colors. Built-in
// workspaces are generated by code; user workspaces are `<name>.scws` files in the `workspaces` folder next to the
// executable and can be exported / imported anywhere.

WS_MAX :: 32
WS_EXT :: ".scws"

Ws_Entry :: struct {
	name:    string,
	path:    string, // saved workspaces only
	builtin: int, // index into WS_BUILTIN_NAMES, or -1 for a saved workspace
}

WS_BUILTIN_NAMES := [?]string{"Default", "Illustration", "Font Design", "Animation"}

ws_entries: [dynamic]Ws_Entry
ws_current: string // name of the workspace applied last (not remembered between runs)

FILTERS_WS := [?]Filter{{"Pangolin Scales workspace (*.scws)", "*.scws"}, {"All files", "*.*"}}

// ---------------------------------------------------------------------------
// Serialization
// ---------------------------------------------------------------------------

workspace_text :: proc() -> string {
	return fmt.tprintf("scws=1\ngroups=%s\n", tool_groups_serialize())
}

// Applies workspace text; false (and nothing changed) if it holds no tool groups.
workspace_apply_text :: proc(text: string) -> bool {
	if !strings.contains(text, "groups=") do return false
	rest := text
	for line in strings.split_lines_iterator(&rest) {
		eq := strings.index_byte(line, '=')
		if eq < 0 do continue
		if strings.trim_space(line[:eq]) == "groups" do tool_groups_parse(strings.trim_space(line[eq + 1:]))
	}
	workspace_pick_first_tool()
	return true
}

@(private = "file")
workspace_pick_first_tool :: proc() {
	for &g, gi in tool_groups {
		for t in g.tools {
			if !tool_is_toggle(t) {
				select_tool_in_group(t, gi)
				return
			}
		}
	}
}

// ---------------------------------------------------------------------------
// Built-in workspaces
// ---------------------------------------------------------------------------

@(private = "file")
ws_group :: proc(name: string, key: KeyboardKey, tools: ..Tool) {
	g := Tool_Group {
		key  = key,
		name = make_name(name),
	}
	append(&g.tools, ..tools)
	for t in tools {
		if !tool_is_toggle(t) {
			g.last = t
			break
		}
	}
	append(&tool_groups, g)
}

@(private = "file")
ws_ops :: proc(name: string, key: KeyboardKey, ops: ..Cmd) {
	g := Tool_Group {
		key     = key,
		name    = make_name(name),
		last_op = ops[0],
	}
	append(&g.ops, ..ops)
	append(&tool_groups, g)
}

workspace_builtin :: proc(i: int) {
	tool_groups_clear()
	switch i {
	case 0:
		tool_groups_default()
	case 1:
		// drawing with shapes and paths: the booleans and a set of colors close at hand
		ws_group("Select", .ONE, .Select, .Node, .Picker)
		ws_group("Draw", .TWO, .Pen, .Freehand, .Line, .Text)
		ws_group("Shapes", .THREE, .Rect, .Ellipse)
		ws_ops("Path", .FOUR, .Union, .Subtract, .Intersect, .Exclude, .Combine, .Break_Apart)
		colors := Tool_Group {
			key  = .FIVE,
			name = make_name("Colors"),
		}
		append(&colors.colors, ..DEFAULT_SWATCHES[:])
		append(&tool_groups, colors)
		ws_group("View", .SIX, .Hand, .Zoom, .Grid, .Snap)
	case 2:
		// outlines: points first, the operations that clean them up, and a grid to snap to
		ws_group("Points", .ONE, .Node, .Control, .Select)
		ws_group("Draw", .TWO, .Pen, .Line, .Rect, .Ellipse)
		ws_ops("Outline", .THREE, .Union, .Subtract, .Intersect, .Reverse, .Close_Or_Open, .Simplify, .Offset_Out, .Offset_In)
		ws_group("View", .FOUR, .Hand, .Zoom, .Grid, .Snap)
	case 3:
		// frame by frame: draw, clean up, flip through frames with the onion skin
		ws_group("Draw", .ONE, .Freehand, .Pen, .Line, .Picker)
		ws_group("Shapes", .TWO, .Rect, .Ellipse, .Text)
		ws_group("Edit", .THREE, .Select, .Node)
		ws_group("View", .FOUR, .Hand, .Zoom, .Onion, .Grid)
	}
	group_key_wait = -1
	workspace_pick_first_tool()
}

// ---------------------------------------------------------------------------
// Saved workspaces
// ---------------------------------------------------------------------------

ws_dir :: proc() -> string {
	return fmt.tprintf("%sworkspaces/", gfx_app_dir())
}

ws_path_for :: proc(name: string) -> string {
	return fmt.tprintf("%s%s%s", ws_dir(), name, WS_EXT)
}

// Strips characters that cannot go in a file name.
ws_clean_name :: proc(s: string) -> string {
	sb := strings.builder_make(context.temp_allocator)
	for r in strings.trim_space(s) {
		switch r {
		case '\\', '/', ':', '*', '?', '"', '<', '>', '|':
		case:
			strings.write_rune(&sb, r)
		}
	}
	return strings.trim_space(strings.to_string(sb))
}

ws_refresh :: proc() {
	for e in ws_entries {
		delete(e.name)
		delete(e.path)
	}
	clear(&ws_entries)
	for n, i in WS_BUILTIN_NAMES {
		append(&ws_entries, Ws_Entry{name = strings.clone(n), builtin = i})
	}
	listing, err := os.read_directory_by_path(ws_dir(), -1, context.temp_allocator)
	if err != nil do return
	saved := make([dynamic]Ws_Entry, context.temp_allocator)
	for f in listing {
		if f.type == .Directory || lower_ext(f.name) != WS_EXT do continue
		append(&saved, Ws_Entry{name = strings.clone(path_stem(f.name)), path = strings.clone(f.fullpath), builtin = -1})
	}
	slice.sort_by(saved[:], proc(a, b: Ws_Entry) -> bool {
		return strings.compare(strings.to_lower(a.name, context.temp_allocator), strings.to_lower(b.name, context.temp_allocator)) < 0
	})
	for e in saved {
		if len(ws_entries) >= WS_MAX do break
		append(&ws_entries, e)
	}
}

workspace_apply_index :: proc(i: int) {
	if i < 0 || i >= len(ws_entries) do return
	e := ws_entries[i]
	if e.builtin >= 0 {
		workspace_builtin(e.builtin)
	} else {
		data, ok := read_file(e.path)
		if !ok {
			message("Workspace", fmt.tprintf("Cannot read %s", path_basename(e.path)))
			return
		}
		defer delete(data)
		if !workspace_apply_text(string(data)) {
			message("Workspace", "This is not a valid workspace file.")
			return
		}
	}
	delete(ws_current)
	ws_current = strings.clone(e.name)
	set_statusf("Workspace: %s", e.name)
}

// Saves the current set-up under `name` in the workspaces folder.
workspace_save_named :: proc(name: string) -> bool {
	n := ws_clean_name(name)
	if n == "" {
		set_status("Enter a name for the workspace")
		return false
	}
	os.make_directory_all(ws_dir())
	if !write_file(ws_path_for(n), transmute([]u8)workspace_text()) {
		message("Workspace", "Could not write the workspace file.")
		return false
	}
	delete(ws_current)
	ws_current = strings.clone(n)
	set_statusf("Saved workspace %s", n)
	return true
}

workspace_delete_index :: proc(i: int) {
	if i < 0 || i >= len(ws_entries) || ws_entries[i].builtin >= 0 do return
	os.remove(ws_entries[i].path)
	set_statusf("Deleted workspace %s", ws_entries[i].name)
}

workspace_export :: proc() {
	os.make_directory_all(ws_dir())
	initial := fmt.tprintf("%s%s%s", ws_dir(), ws_current != "" ? ws_current : "workspace", WS_EXT)
	p, ok := native_dialog(true, "Export workspace", FILTERS_WS[:], "scws", initial)
	if !ok do return
	defer delete(p)
	if write_file(p, transmute([]u8)workspace_text()) {
		set_statusf("Exported workspace to %s", path_basename(p))
	} else {
		message("Workspace", "Could not write the workspace file.")
	}
}

// Loads a workspace file, applies it and keeps a copy in the workspaces folder.
workspace_import :: proc() {
	p, ok := native_dialog(false, "Import workspace", FILTERS_WS[:], "scws", "")
	if !ok do return
	defer delete(p)
	data, rok := read_file(p)
	if !rok {
		message("Workspace", fmt.tprintf("Cannot read %s", path_basename(p)))
		return
	}
	defer delete(data)
	if !workspace_apply_text(string(data)) {
		message("Workspace", "This is not a valid workspace file.")
		return
	}
	name := ws_clean_name(path_stem(p))
	if name != "" {
		os.make_directory_all(ws_dir())
		write_file(ws_path_for(name), data)
		delete(ws_current)
		ws_current = strings.clone(name)
	}
	set_statusf("Imported workspace %s", path_basename(p))
}

// ---------------------------------------------------------------------------
// Dialog
// ---------------------------------------------------------------------------

dlg_workspaces :: proc() {
	c := dialog_frame("Workspaces", 320, 150)
	y := c.y
	@(static) names: [WS_MAX]string
	n := len(ws_entries)
	for e, i in ws_entries do names[i] = e.name
	dialog.a = clamp(dialog.a, 0, n - 1)
	PICK_TIP :: "Choose a workspace to load or delete. A workspace is a whole tool set-up: the groups, their hotkeys, operations and colors."
	tip_text(c.x, y + 3, "Workspace", C_TEXT, {"Workspace", PICK_TIP})
	if nv, ch := combo(Rect{c.x + 80, y, c.w - 80, 14}, names[:n], dialog.a, {"Workspace", PICK_TIP}); ch do dialog.a = nv
	y += 22
	if button(Rect{c.x, y, 60, 16}, "Load", {"Load", "Switch to the selected workspace. Your current tool groups are replaced, so save them first if you want to keep them."}) {
		workspace_apply_index(dialog.a)
	}
	saved := ws_entries[dialog.a].builtin < 0
	if button(Rect{c.x + 66, y, 60, 16}, "Delete", {"Delete", "Delete the selected workspace's file. The built-in workspaces can't be deleted."}, saved) {
		workspace_delete_index(dialog.a)
		ws_refresh()
	}
	y += 24
	SAVE_NAME_TIP :: Tip{"Save as", "The name to save the current tool set-up under."}
	tip_text(c.x, y + 3, "Save as", C_TEXT, SAVE_NAME_TIP)
	text_field(Rect{c.x + 80, y, c.w - 80 - 66, 14}, &dialog.name, SAVE_NAME_TIP)
	if button(Rect{c.x + c.w - 60, y - 1, 60, 16}, "Save", {"Save", "Save the current tool set-up as a workspace under the name on the left. A workspace with that name is replaced."}) {
		if workspace_save_named(name_str(&dialog.name)) {
			ws_refresh()
			for e, i in ws_entries {
				if e.builtin < 0 && e.name == ws_current do dialog.a = i
			}
		}
	}
	y += 24
	if button(Rect{c.x, y, 80, 16}, "Import...", {"Import", cmd_help(.Ws_Import)}) {
		workspace_import()
		ws_refresh()
	}
	if button(Rect{c.x + 86, y, 80, 16}, "Export...", {"Export", cmd_help(.Ws_Export)}) do workspace_export()
	if ok, _ := dialog_buttons(c, "Close this window (Enter or Esc).", "Close", ""); ok do dialog_close()
}
